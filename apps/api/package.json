{
  "name": "@credito/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json || true",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrar.ts",
    "db:seed": "tsx src/db/semilla.ts"
  },
  "dependencies": {
    "@credito/shared": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@libsql/client": "^0.17.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "fastify-type-provider-zod": "7.0.0",
    "openai": "^7.4.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.1.2",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
