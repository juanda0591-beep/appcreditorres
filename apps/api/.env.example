# Copia este archivo a .env y ajusta lo que necesites.
# .env NUNCA se sube al repositorio (ya esta en .gitignore).

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Base de datos SQLite (libSQL)
DB_RUTA=./datos/credito.db
# Para usar una base remota en Turso, descomenta y pon la URL:
# DB_URL=libsql://tu-base.turso.io

# Fotos de productos ya procesadas
CARPETA_IMAGENES=./datos/imagenes
MAX_BYTES_IMAGEN=12582912

# URL publica del sitio. En el VPS debe ser tu dominio real, porque de aqui
# sale el enlace que se comparte por WhatsApp y la vista previa del chat.
URL_PUBLICA=http://localhost:3000

# Origenes del frontend autorizados, separados por coma
CORS_ORIGENES=http://localhost:5173

# Secreto para firmar las cookies de sesion. OBLIGATORIO en produccion.
# Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_COOKIES=
