# Variables de entorno para PRODUCCIÓN
# Copia este archivo a /var/www/appcreditorres/.env y configura los valores

# =======================
# CONFIGURACIÓN DEL SERVIDOR
# =======================
NODE_ENV=production
PORT=3000

# =======================
# BASE DE DATOS
# =======================
# Ruta absoluta a la base de datos SQLite en el servidor
DATABASE_URL=file:/var/www/appcreditorres/database.db

# =======================
# WHATSAPP (Baileys)
# =======================
# Directorio donde se guardarán las sesiones de WhatsApp
WHATSAPP_SESSION_PATH=/var/www/appcreditorres/whatsapp-session

# =======================
# OPENAI (Configurado desde el admin)
# =======================
# No es necesario configurar aquí, se configura desde la interfaz web
# OPENAI_API_KEY=sk-...

# =======================
# SEGURIDAD
# =======================
# Secreto para JWT (genera uno aleatorio)
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo-y-seguro

# Usuarios admin (opcional, si usas autenticación)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-segura

# =======================
# LOGS
# =======================
LOG_LEVEL=info

# =======================
# BACKUPS
# =======================
BACKUP_PATH=/root/backups

# =======================
# DOMINIO (opcional)
# =======================
# Si tienes un dominio configurado
DOMAIN=tudominio.com
# O usa la IP del VPS
# DOMAIN=123.45.67.89

# =======================
# CORS (para frontend)
# =======================
# Si el frontend está en otro dominio
ALLOWED_ORIGINS=https://tudominio.com,http://tudominio.com

# =======================
# TIMEZONE
# =======================
TZ=America/Bogota
